{
  "_comment": "Median of 3 runs is used for each score. SEO is asserted from Phase 8 on every page except the 404 page, which is noindex on purpose.",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*404).*$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    }
  }
}

---
// About: short and calm (mockup B pacing). Under 150 words. The founder's own text (supplied 21 Nov 2026);
// nothing here is invented. No phone number or ID numbers. `npm run check:brackets` lists any placeholder left.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Durbeen: an independent lab for practical AI | Durbeen"
  description="About Durbeen and Fahad Ehsan, who tests AI tools by building with them and writes up what works."
>
  <article class="container page">
    <p class="label">ABOUT</p>
    <h1>Look further. Look closer. Then build.</h1>

    <div class="text">
      <p>Durbeen is an independent lab testing AI on real work. The name means telescope.</p>
      <p>
        I'm Fahad Ehsan. After 18+ years in engineering, I'm learning AI the way engineers learn anything: by testing it
        on real work.
      </p>
      <p>
        Here I share what I build, what works, what doesn't, and how AI can help with reports, documents and
        everyday workflows. I'm a learner, not a guru. Every tool I write about, I've actually used. If something here saves
        you an hour, it was worth publishing.
      </p>
      <p>Current work is on the <a href="/projects/">Projects</a> page. To get in touch: <a class="mail" href="mailto:hello@durbeen.io">hello@durbeen.io</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(64px, 9vw, 140px) var(--space-section);
  }
  .label {
    margin: 0 0 var(--space-4);
  }
  h1 {
    max-width: 1000px;
    margin: 0 0 clamp(48px, 7vw, 96px);
    font-size: clamp(44px, 7vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .text {
    max-width: 620px;
    font-size: 20px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .text p {
    margin: 0 0 var(--space-3);
  }
  .mail {
    font-family: var(--font-mono);
    font-size: 17px;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

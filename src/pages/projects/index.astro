---
// Projects list: a dark header band (mockup B) and one row per project with its status label.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects: from notes to working tools | Durbeen"
  description="The projects Durbeen is building and has built, each with its status: durbeen.io, TokenSave and a personal CV website."
>
  <section class="band" aria-labelledby="projects-title">
    <div class="container inner">
      <p class="label">[ 01 ] PROJECTS</p>
      <h1 id="projects-title">From notes to working tools.</h1>
      <p class="intro">When something we review proves useful, we build on it.</p>
    </div>
  </section>

  <section class="container list" aria-label="All projects">
    {
      projects.length > 0 ? (
        <ul>
          {projects.map((p, i) => (
            <ProjectRow
              title={p.data.title}
              summary={p.data.summary}
              status={p.data.status}
              href={`/projects/${p.id}/`}
              first={i === 0}
            />
          ))}
        </ul>
      ) : (
        <p class="none">Projects will appear here.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .band {
    background: var(--band);
    color: var(--on-band);
  }
  .inner {
    padding-block: clamp(64px, 9vw, 140px);
  }
  .label {
    margin: 0 0 var(--space-4);
    color: var(--accent-on-dark);
  }
  h1 {
    max-width: 900px;
    margin: 0 0 var(--space-3);
    font-size: clamp(40px, 5.5vw, 80px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--on-band);
  }
  .intro {
    max-width: 560px;
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--on-band-2);
  }
  .list {
    padding-block: clamp(48px, 6vw, 96px) var(--space-section);
  }
  ul {
    margin: 0;
    padding: 0;
  }
  .none {
    margin: 0;
    color: var(--text-2);
  }
</style>

---
// Internal component preview. Every shared component appears here with its variants and states.
// Hidden from search engines. REMOVE before the Phase 8 launch (see docs/DECISIONS.md).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/Button.astro';
import Tag from '../../../components/Tag.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import Header from '../../../components/Header.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import StatusStrip from '../../../components/StatusStrip.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import LogRow from '../../../components/LogRow.astro';
import TOC from '../../../components/TOC.astro';
import Callout from '../../../components/Callout.astro';
import VerdictBox from '../../../components/VerdictBox.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
---

<BaseLayout
  title="Component preview · Durbeen"
  description="Internal preview of every shared Durbeen component, with variants and states."
  noindex
>
  <div class="container section">
    <p class="label">[ DS ] COMPONENT PREVIEW · INTERNAL</p>
    <h1 style="margin-top: var(--space-3)">Components</h1>
    <p class="reading" style="margin-top: var(--space-4); font-size: 20px; color: var(--text-2)">
      Each component is built once and shown here in every state. Tab through the page to check
      keyboard access. <a href="/design-system/">Back to tokens</a>.
    </p>
    <div style="margin-top: var(--space-4)"><ThemeToggle /></div>

    <nav aria-label="Components" class="toc">
      <ul>
        <li><a href="#button">Button</a></li>
        <li><a href="#tag">Tag</a></li>
        <li><a href="#section-label">SectionLabel</a></li>
        <li><a href="#header">Header</a></li>
        <li><a href="#newsletter">NewsletterForm</a></li>
        <li><a href="#footer">Footer</a></li>
        <li><a href="#article-card">ArticleCard</a></li>
        <li><a href="#log-row">LogRow</a></li>
        <li><a href="#toc">TOC</a></li>
        <li><a href="#callout">Callout</a></li>
        <li><a href="#verdict">VerdictBox</a></li>
      </ul>
    </nav>

    <!-- BUTTON -->
    <section id="button" aria-labelledby="button-h">
      <hr />
      <SectionLabel number={1}>BUTTON</SectionLabel>
      <h2 id="button-h" class="h2-sm">Button</h2>

      <p class="label-sm">PRIMARY · DEFAULT / HOVER / FOCUS / DISABLED</p>
      <div class="row">
        <Button href="/design-system/components/#button" arrow>Read the latest</Button>
        <Button class="is-hover" href="/design-system/components/#button" arrow>Hover</Button>
        <Button class="is-focus" href="/design-system/components/#button" arrow>Focus</Button>
        <Button disabled>Disabled</Button>
      </div>

      <p class="label-sm">SECONDARY</p>
      <div class="row">
        <Button variant="secondary" href="/design-system/components/#button">Default</Button>
        <Button variant="secondary" class="is-hover" href="/design-system/components/#button">Hover</Button>
        <Button variant="secondary" class="is-focus" href="/design-system/components/#button">Focus</Button>
        <Button variant="secondary" disabled>Disabled</Button>
      </div>

      <p class="label-sm">TEXT LINK</p>
      <div class="row">
        <Button variant="text" href="/design-system/components/#button">See projects</Button>
        <Button variant="text" class="is-hover" href="/design-system/components/#button">Hover</Button>
        <Button variant="text" class="is-focus" href="/design-system/components/#button">Focus</Button>
        <Button variant="text" arrow href="/design-system/components/#button">With arrow</Button>
      </div>

      <p class="label-sm">INK · SUBMIT BUTTON (A REAL &lt;BUTTON&gt;, NOT A LINK)</p>
      <div class="row">
        <Button variant="ink" type="button">Subscribe</Button>
        <Button variant="ink" class="is-hover" type="button">Hover</Button>
      </div>

      <p class="label-sm">ON A DARK BAND</p>
      <div class="band">
        <div class="row">
          <Button onDark href="/design-system/components/#button" arrow>Read the latest</Button>
          <Button onDark variant="ink" type="button">Subscribe</Button>
          <Button onDark variant="secondary" href="/design-system/components/#button">Secondary</Button>
          <Button onDark variant="text" href="/design-system/components/#button">See projects</Button>
          <Button onDark disabled>Disabled</Button>
        </div>
      </div>
    </section>

    <!-- TAG -->
    <section id="tag" aria-labelledby="tag-h">
      <hr />
      <SectionLabel number={2}>TAG</SectionLabel>
      <h2 id="tag-h" class="h2-sm">Tag</h2>

      <p class="label-sm">HASH TAGS · PLAIN TEXT AND LINKS (44PX HIT AREA)</p>
      <div class="row">
        <Tag label="github" />
        <Tag label="security" />
        <Tag label="open-source" />
        <Tag label="github" href="/design-system/components/#tag" />
        <Tag label="security" href="/design-system/components/#tag" />
      </div>

      <p class="label-sm">CHIPS · TYPE AND LEVEL</p>
      <div class="row">
        <Tag variant="chip" label="Review" />
        <Tag variant="chip" label="Guide" />
        <Tag variant="chip" label="Beginner" />
        <Tag variant="chip" label="Intermediate" href="/design-system/components/#tag" />
      </div>

      <p class="label-sm">ON A DARK BAND</p>
      <div class="band">
        <div class="row">
          <Tag onDark label="github" />
          <Tag onDark label="security" href="/design-system/components/#tag" />
          <Tag onDark variant="chip" label="Review" />
          <Tag onDark variant="chip" label="Advanced" href="/design-system/components/#tag" />
        </div>
      </div>
    </section>

    <!-- SECTION LABEL -->
    <section id="section-label" aria-labelledby="sl-h">
      <hr />
      <SectionLabel number={3}>SECTION LABEL</SectionLabel>
      <h2 id="sl-h" class="h2-sm">SectionLabel</h2>

      <p class="label-sm">ON PAPER</p>
      <div class="stack">
        <SectionLabel number={0}>DISCOVER → EVALUATE → BUILD → SHARE</SectionLabel>
        <SectionLabel number={1}>INSIGHTS</SectionLabel>
        <SectionLabel number={3}>PROJECTS</SectionLabel>
      </div>

      <p class="label-sm">ON A DARK BAND</p>
      <div class="band">
        <SectionLabel number={2} onDark>METHOD</SectionLabel>
      </div>
    </section>

    <!-- HEADER -->
    <section id="header" aria-labelledby="header-h">
      <hr />
      <SectionLabel number={4}>HEADER</SectionLabel>
      <h2 id="header-h" class="h2-sm">Header + StatusStrip</h2>
      <p class="reading" style="margin-top: var(--space-2)">
        The live Header is at the top of this page; the two below are demos. Below 860px the nav collapses behind MENU (Esc closes it). Resize the window to see both layouts.
        Search stays off until Pagefind exists (Phase 4).
      </p>

      <p class="label-sm">DEFAULT (SEARCH OFF, NO LOG DATA)</p>
      <div class="frame"><Header currentPath="/" id="demo-nav-1" navLabel="Demo A" /></div>

      <p class="label-sm">SEARCH ON · LOG DATA · "INSIGHTS" IS THE CURRENT PAGE</p>
      <div class="frame">
        <Header search log={{ date: '18.11.2026', number: 12 }} currentPath="/insights/" id="demo-nav-2" navLabel="Demo B" />
      </div>

      <p class="label-sm">STATUS STRIP ALONE</p>
      <div class="frame"><StatusStrip log={{ date: '18.11.2026', number: 12 }} /></div>
    </section>

    <!-- NEWSLETTER FORM -->
    <section id="newsletter" aria-labelledby="nl-h">
      <hr />
      <SectionLabel number={5}>NEWSLETTER FORM</SectionLabel>
      <h2 id="nl-h" class="h2-sm">NewsletterForm</h2>
      <p class="reading" style="margin-top: var(--space-2)">
        Posts to Kit's hosted form (Phase 5). Until an endpoint is passed, it is disabled so it never
        looks live when it is not.
      </p>
      <p class="label-sm">NOT CONNECTED YET (CURRENT STATE ON THE SITE)</p>
      <NewsletterForm id="demo-nl-1" />
      <p class="label-sm">CONNECTED (DEMO ENDPOINT, DOES NOT SUBMIT ANYWHERE REAL)</p>
      <NewsletterForm id="demo-nl-2" action="#newsletter" />
    </section>

    <!-- FOOTER -->
    <section id="footer" aria-labelledby="footer-h">
      <hr />
      <SectionLabel number={6}>FOOTER</SectionLabel>
      <h2 id="footer-h" class="h2-sm">Footer</h2>
      <p class="reading" style="margin-top: var(--space-2)">
        The live Footer is at the bottom of this page and every other page. The live Header is at the top.
      </p>
    </section>

    <!-- ARTICLE CARD -->
    <section id="article-card" aria-labelledby="ac-h">
      <hr />
      <SectionLabel number={7}>ARTICLE CARD</SectionLabel>
      <h2 id="ac-h" class="h2-sm">ArticleCard</h2>
      <p class="reading" style="margin-top: var(--space-2)">
        The whole card is one click target through the title link. Sample text only; real articles arrive in Phase 4.
      </p>

      <p class="label-sm">FEATURED (FIGURE SLOT EMPTY = RETICLE PLACEHOLDER)</p>
      <ArticleCard
        variant="featured"
        number={12}
        type="Repo review"
        title="UI/UX Pro Max: what's actually inside a viral design skill"
        description="We installed it, read every script, and tested it on a real website. What it does well, where it makes everything look the same, and how to use it safely."
        href="/design-system/components/#article-card"
        minutes={8}
        date={new Date('2026-11-18')}
      />

      <p class="label-sm">DEFAULT · GRID OF THREE</p>
      <div class="cards">
        <ArticleCard number={11} type="Experiment" title="Converting any file to Markdown to cut AI token costs" description="A small automation that turns PDFs, Word and Excel files into clean text before they reach an AI model." href="/design-system/components/#article-card" minutes={6} />
        <ArticleCard number={10} type="Guide" title="How to judge a GitHub repo before you trust it" description="Stars, licence, last commit, install scripts: a ten-minute checklist for anything you plan to run." href="/design-system/components/#article-card" minutes={11} />
        <ArticleCard number={9} type="Build note" title="Building durbeen.io in public: week one" description="Why we threw away the first design, and what an independent lab website should actually do." href="/design-system/components/#article-card" minutes={5} />
      </div>
    </section>

    <!-- LOG ROW -->
    <section id="log-row" aria-labelledby="lr-h">
      <hr />
      <SectionLabel number={8}>LOG ROW</SectionLabel>
      <h2 id="lr-h" class="h2-sm">LogRow</h2>
      <p class="label-sm">IN AN OBSERVATION LOG PANEL (LONG TITLE WRAPS; TIME STAYS ON ONE LINE)</p>
      <ul class="log">
        <LogRow number={12} type="Repo review" title="UI/UX Pro Max: what's actually inside a viral design skill" minutes={8} href="/design-system/components/#log-row" />
        <LogRow number={11} type="Experiment" title="Converting any file to Markdown to cut AI token costs" minutes={6} href="/design-system/components/#log-row" />
        <LogRow number={10} type="Guide" title="How to judge a GitHub repo before you trust it" minutes={11} href="/design-system/components/#log-row" />
      </ul>
    </section>

    <!-- TOC -->
    <section id="toc" aria-labelledby="toc-h">
      <hr />
      <SectionLabel number={9}>TOC</SectionLabel>
      <h2 id="toc-h" class="h2-sm">TOC</h2>
      <p class="reading" style="margin-top: var(--space-2)">
        Scroll the sample article: the section being read gets the accent rule. Hover and keyboard focus are shown too.
      </p>
      <div class="article-demo">
        <div class="toc-col">
          <TOC id="demo-toc" items={[
            { id: 'demo-s1', text: 'Why stars mislead' },
            { id: 'demo-s2', text: 'The ten-minute check' },
            { id: 'demo-s3', text: 'Read the install script' },
          ]} />
        </div>
        <div class="reading demo-text">
          <h3 id="demo-s1">Why stars mislead</h3>
          <p>Stars measure attention, not quality, and certainly not safety. A project can collect thousands of stars in a week from one viral post.</p>
          <p>That tells you people were curious. It tells you nothing about who maintains it, what it installs, or whether it still works.</p>
          <h3 id="demo-s2">The ten-minute check</h3>
          <p>Before installing anything, check the licence, the last commit, the owner, the install path and the network calls.</p>
          <p>Sample text only. Real articles arrive in Phase 4.</p>
          <h3 id="demo-s3">Read the install script</h3>
          <p>Search the code for anything that downloads, executes or deletes. A two-line search catches most surprises.</p>
          <p>Keep scrolling to see the last item become current.</p>
        </div>
      </div>
    </section>

    <!-- CALLOUT -->
    <section id="callout" aria-labelledby="co-h">
      <hr />
      <SectionLabel number={10}>CALLOUT</SectionLabel>
      <h2 id="co-h" class="h2-sm">Callout</h2>
      <div class="reading">
        <p class="label-sm">NOTE (DEFAULT)</p>
        <Callout><p>Pagefind builds its search index after the site build, so search does not work in <code>npm run dev</code>.</p></Callout>
        <p class="label-sm">WARNING</p>
        <Callout variant="warning"><p>Never run an install script you have not read. Search it for <code>curl</code>, <code>eval</code> and <code>rm -rf</code> first.</p></Callout>
        <p class="label-sm">CUSTOM LABEL</p>
        <Callout label="Last verified 18.11.2026"><p>Checked against version 2.4. Later versions may differ.</p></Callout>
      </div>
    </section>

    <!-- VERDICT BOX -->
    <section id="verdict" aria-labelledby="vb-h">
      <hr />
      <SectionLabel number={11}>VERDICT BOX</SectionLabel>
      <h2 id="vb-h" class="h2-sm">VerdictBox</h2>
      <div class="reading">
        <p class="label-sm">ARTICLE VERDICT</p>
        <VerdictBox call="Use the checklist">
          <p>Ten minutes of checking is cheap. Cleaning up a compromised laptop is not. Save this routine and run it every time.</p>
        </VerdictBox>
        <p class="label-sm">REVIEW VERDICT WITH SCORECARD (SETUP · DOCS · MAINTENANCE · SAFETY)</p>
        <VerdictBox call="Use with care" scores={{ setup: 4, docs: 3, maintenance: 5, safety: 2 }}>
          <p>Works well and is actively maintained, but the install script runs unreviewed code. Read it first.</p>
        </VerdictBox>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  section > .label-sm {
    margin: var(--space-4) 0 var(--space-2);
  }
  .h2-sm {
    margin-top: var(--space-2);
    font-size: 36px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .stack {
    display: grid;
    gap: var(--space-2);
  }
  .band {
    padding: var(--space-4);
    background: var(--band);
    color: var(--on-band);
  }
  .frame {
    border: 1px solid var(--ui-border);
    background: var(--paper);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
  }
  .log {
    margin: 0;
    padding: 0;
    max-width: 520px;
    border: 1px solid var(--ink);
    background: var(--surface);
  }
  .article-demo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    align-items: flex-start;
  }
  .toc-col {
    flex: 1 1 200px;
    max-width: 240px;
    position: sticky;
    top: var(--space-2);
  }
  .demo-text {
    flex: 4 1 360px;
    min-width: 0;
  }
  .demo-text :global(h3) {
    margin-top: 120px;
    font-size: 30px;
  }
  .demo-text :global(h3:first-child) {
    margin-top: 0;
  }
  .toc {
    margin-top: var(--space-5);
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
</style>

---
// Infographics gallery: every picture used in a published article (the hero and the figures in the text),
// newest article first, as a grid of tiles. Each tile links to its article, which is the full written version.
// A new article's pictures appear here by themselves (connection map, CLAUDE.md section 8). Drafts never show.
import BaseLayout from '../layouts/BaseLayout.astro';
import ListHeader from '../components/ListHeader.astro';
import InsightsFilters from '../components/InsightsFilters.astro';
import InfographicCard from '../components/InfographicCard.astro';
import { getArticles, articleHref } from '../lib/articles';
import { categories } from '../lib/taxonomy';

// Every image kept next to the articles, so a figure written as ![alt](./images/x.png "caption") can be found again.
const files = import.meta.glob<ImageMetadata>('/src/content/insights/images/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
  import: 'default',
});
const figure = /!\[([^\]]*)\]\(\s*\.\/images\/([^)\s]+)(?:\s+"([^"]*)")?\s*\)/g;

type Tile = { article: Awaited<ReturnType<typeof getArticles>>[number]; image: ImageMetadata; alt: string; caption?: string };
const tiles: Tile[] = [];
for (const article of await getArticles()) {
  const seen = new Set<string>();
  const add = (image: ImageMetadata, alt: string, caption?: string) => {
    if (seen.has(image.src)) return;
    seen.add(image.src);
    tiles.push({ article, image, alt, caption });
  };
  if (article.data.heroImage) add(article.data.heroImage, article.data.heroAlt!);
  for (const m of (article.body ?? '').matchAll(figure)) {
    const image = files[`/src/content/insights/images/${m[2]}`];
    if (!image) throw new Error(`${article.id}: figure ./images/${m[2]} was not found in src/content/insights/images/`);
    add(image, m[1], m[3]);
  }
}
const groups = [{ name: 'category' as const, label: 'CATEGORY', options: [...categories] }];
---

<BaseLayout
  title="Infographics: pictures that explain one idea | Durbeen"
  description="Durbeen infographics, newest first: one idea per picture, each linked to the article that holds its full written version."
>
  <ListHeader
    label="INFOGRAPHICS"
    title="Infographics"
    intro="One idea per picture, and every picture comes with a full written version: the article it belongs to. Newest first."
  />
  <div class="container body">
    {
      tiles.length > 0 ? (
        <>
          <InsightsFilters groups={groups} noun="INFOGRAPHIC" />
          <ul class="grid">
            {tiles.map((t) => (
              <InfographicCard
                number={t.article.data.number}
                category={t.article.data.category}
                fromTitle={t.article.data.title}
                caption={t.caption}
                href={articleHref(t.article)}
                image={t.image}
                alt={t.alt}
              />
            ))}
          </ul>
          <div class="empty" data-filter-empty hidden>
            <p>No infographics in this category yet.</p>
            <button type="button" data-filter-reset>Show all infographics</button>
          </div>
        </>
      ) : (
        <p class="none">The first infographics are on the way.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .body {
    padding-bottom: var(--space-section);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-6) var(--space-4);
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--ink);
  }
  .none,
  .empty p {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
    color: var(--text-2);
  }
  .empty {
    padding-block: var(--space-4);
  }
  .empty button {
    min-height: var(--touch-target);
    padding: 0 20px;
    border: 1px solid var(--ui-border);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }
</style>

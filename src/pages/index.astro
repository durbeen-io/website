---
// Home (Homepage A, "Instrument Lab"). Sections are added one PR at a time:
// hero + Observation Log, statement, Insights, Method, Projects. The footer comes from BaseLayout.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ObservationLog from '../components/ObservationLog.astro';
import Reticle from '../components/Reticle.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { getArticles, articleHref, readingMinutes } from '../lib/articles';

const articles = await getArticles();
const latest = articles[0];
const logEntries = articles.slice(0, 4).map((a) => ({
  number: a.data.number,
  type: a.data.type,
  title: a.data.title,
  minutes: readingMinutes(a),
  href: articleHref(a),
}));

// Insights: the newest article marked `featured` (or just the newest) plus the next three.
const featured = articles.find((a) => a.data.featured) ?? latest;
const recent = articles.filter((a) => a !== featured).slice(0, 3);
const card = (a: (typeof articles)[number]) => ({
  number: a.data.number,
  type: a.data.type,
  title: a.data.title,
  description: a.data.description,
  href: articleHref(a),
  minutes: readingMinutes(a),
});

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// The four steps of the method (brief section 1). Copy follows the mockup.
const steps = [
  { n: '01', name: 'Discover', text: 'Find AI tools and ideas that could save you real time.' },
  { n: '02', name: 'Evaluate', text: 'Try them on real work: reports, documents, data. Note what breaks.' },
  { n: '03', name: 'Build', text: 'Turn what works into small tools and workflows I actually use.' },
  { n: '04', name: 'Share', text: 'Write it up honestly, so you can skip the trial and error.' },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Durbeen',
  url: Astro.site!.href,
  logo: `${Astro.site!.href}icon-512.png`,
  description:
    'Durbeen is an independent lab for practical AI. I test AI tools and workflows by building with them, and write up what works, what breaks, and why.',
  sameAs: ['https://github.com/durbeen-io'],
};
---

<BaseLayout
  jsonLd={[organization]}
  title="Durbeen: field notes from the edge of technology"
  description="Durbeen is an independent lab for practical AI. I test AI tools and workflows by building with them, and write up what works, what breaks, and why."
>
  <section class="hero container">
    <div class="intro">
      <p class="label kicker"><span aria-hidden="true">[ 00 ]</span> Discover → Evaluate → Build → Share</p>
      <h1>Field notes from the edge of technology.</h1>
      <p class="lede">
        Durbeen is an independent lab. I test AI tools on real work (reports, documents, data), write down what
        breaks, and keep what helps.
      </p>
      <div class="actions">
        <Button href={latest ? articleHref(latest) : '/insights/'} arrow>Read the latest</Button>
        <Button variant="text" href="/projects/">See projects</Button>
      </div>
    </div>
    <div class="log">
      <ObservationLog entries={logEntries} />
    </div>
  </section>

  <section class="statement" aria-labelledby="statement-title">
    <div class="container inner">
      <h2 id="statement-title">Look closer.<br /><span>Then build.</span></h2>
      <Reticle target={latest?.data.number} />
    </div>
  </section>

  <section class="insights container section" aria-labelledby="insights-title">
    <h2 id="insights-title" class="visually-hidden">Latest insights</h2>
    <div class="head">
      <SectionLabel number={1}>Insights</SectionLabel>
      <Button variant="text" href="/insights/" arrow>All insights</Button>
    </div>
    {
      featured ? (
        <>
          <div class="featured">
            <ArticleCard variant="featured" {...card(featured)} date={featured.data.publishDate} />
          </div>
          {recent.length > 0 && (
            <div class="recent">
              {recent.map((a) => (
                <ArticleCard {...card(a)} />
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="none">The first articles are on the way.</p>
      )
    }
  </section>

  <section class="method" aria-labelledby="method-title">
    <div class="container section">
      <SectionLabel number={2} onDark>Method</SectionLabel>
      <h2 id="method-title">Test before you trust.</h2>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class:list={{ last: s.n === '04' }}>
              <span class="numeral num" aria-hidden="true">{s.n}</span>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="projects container section" aria-labelledby="projects-title">
    <h2 id="projects-title" class="visually-hidden">Projects</h2>
    <div class="head">
      <SectionLabel number={3}>Projects</SectionLabel>
      <Button variant="text" href="/projects/" arrow>All projects</Button>
    </div>
    {
      projects.length > 0 ? (
        <ul class="rows">
          {projects.map((p, i) => (
            <ProjectRow title={p.data.title} summary={p.data.summary} status={p.data.status} href={`/projects/${p.id}/`} first={i === 0} />
          ))}
        </ul>
      ) : (
        <p class="none">Projects will appear here.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: flex-start;
    padding-block: clamp(48px, 7vw, 96px) clamp(64px, 9vw, 120px);
  }
  .intro {
    flex: 7 1 520px;
    min-width: 0;
  }
  .log {
    flex: 5 1 380px;
    min-width: 0;
  }
  .kicker {
    margin: 0 0 var(--space-4);
  }
  h1 {
    margin: 0 0 var(--space-5);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .lede {
    max-width: 600px;
    margin: 0 0 48px;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .statement {
    border-block: var(--border);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(80px, 12vw, 160px);
  }
  .statement h2 {
    flex: 1 1 560px;
    min-width: 0;
    font-size: clamp(40px, 5.5vw, 80px);
    line-height: 1.02;
  }
  .statement h2 span {
    color: var(--muted);
  }
  .statement :global(svg) {
    flex: 0 0 auto;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: 48px;
  }
  .featured {
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .recent {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .none {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
    color: var(--text-2);
  }

  .method {
    background: var(--band);
    color: var(--on-band);
  }
  .method h2 {
    max-width: 900px;
    margin: var(--space-5) 0 clamp(48px, 6vw, 80px);
    color: var(--on-band);
  }
  .steps {
    display: grid;
    /* Phone: stacked. Tablet: 2x2. Desktop: one row of four. Never 3 + 1. */
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 600px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps li {
    list-style: none;
    padding: 28px 28px 48px 0;
    border-top: 1px solid var(--on-band);
  }
  .num {
    display: block;
    margin-bottom: 28px;
    font-size: 56px;
  }
  .steps .last .num {
    color: var(--accent-on-dark);
  }
  .steps h3 {
    margin: 0 0 12px;
    font-size: 22px;
    letter-spacing: 0;
    color: var(--on-band);
  }
  .steps p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--on-band-2);
  }
  .rows {
    margin: 0;
    padding: 0;
  }
</style>

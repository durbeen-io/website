---
// Home (Homepage A, "Instrument Lab"). Sections are added one PR at a time:
// hero + Observation Log, statement, Insights (this PR); Method, Projects (next PR).
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ObservationLog from '../components/ObservationLog.astro';
import Reticle from '../components/Reticle.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, articleHref, readingMinutes } from '../lib/articles';

const articles = await getArticles();
const latest = articles[0];
const logEntries = articles.slice(0, 4).map((a) => ({
  number: a.data.number,
  type: a.data.type,
  title: a.data.title,
  minutes: readingMinutes(a),
  href: articleHref(a),
}));

// Insights: the newest article marked `featured` (or just the newest) plus the next three.
const featured = articles.find((a) => a.data.featured) ?? latest;
const recent = articles.filter((a) => a !== featured).slice(0, 3);
const card = (a: (typeof articles)[number]) => ({
  number: a.data.number,
  type: a.data.type,
  title: a.data.title,
  description: a.data.description,
  href: articleHref(a),
  minutes: readingMinutes(a),
});
---

<BaseLayout
  title="Durbeen: field notes from the edge of technology"
  description="Durbeen is an independent technology lab and publication. Reviews, experiments and build notes on AI, open source and practical tools."
>
  <section class="hero container">
    <div class="intro">
      <p class="label kicker"><span aria-hidden="true">[ 00 ]</span> Discover → Evaluate → Build → Share</p>
      <h1>Field notes from the edge of technology.</h1>
      <p class="lede">
        Durbeen is an independent lab. We find useful open-source tools and AI, test them properly, and build practical
        things with what works.
      </p>
      <div class="actions">
        <Button href={latest ? articleHref(latest) : '/insights/'} arrow>Read the latest</Button>
        <Button variant="text" href="/projects/">See projects</Button>
      </div>
    </div>
    <div class="log">
      <ObservationLog entries={logEntries} />
    </div>
  </section>

  <section class="statement" aria-labelledby="statement-title">
    <div class="container inner">
      <h2 id="statement-title">Look closer.<br /><span>Then build.</span></h2>
      <Reticle target={latest?.data.number} />
    </div>
  </section>

  <section class="insights container section" aria-labelledby="insights-title">
    <h2 id="insights-title" class="visually-hidden">Latest insights</h2>
    <div class="head">
      <SectionLabel number={1}>Insights</SectionLabel>
      <Button variant="text" href="/insights/" arrow>All insights</Button>
    </div>
    {
      featured ? (
        <>
          <div class="featured">
            <ArticleCard variant="featured" {...card(featured)} date={featured.data.publishDate} />
          </div>
          {recent.length > 0 && (
            <div class="recent">
              {recent.map((a) => (
                <ArticleCard {...card(a)} />
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="none">The first articles are on the way.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: flex-start;
    padding-block: clamp(48px, 7vw, 96px) clamp(64px, 9vw, 120px);
  }
  .intro {
    flex: 7 1 520px;
    min-width: 0;
  }
  .log {
    flex: 5 1 380px;
    min-width: 0;
  }
  .kicker {
    margin: 0 0 var(--space-4);
  }
  h1 {
    margin: 0 0 var(--space-5);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .lede {
    max-width: 600px;
    margin: 0 0 48px;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .statement {
    border-block: var(--border);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(80px, 12vw, 160px);
  }
  .statement h2 {
    flex: 1 1 560px;
    min-width: 0;
    font-size: clamp(40px, 5.5vw, 80px);
    line-height: 1.02;
  }
  .statement h2 span {
    color: var(--muted);
  }
  .statement :global(svg) {
    flex: 0 0 auto;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: 48px;
  }
  .featured {
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .recent {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .none {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
    color: var(--text-2);
  }
</style>

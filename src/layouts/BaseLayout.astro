---
// Shared page shell: <head>, skip link, Header, <main>, Footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { getArticles, logDate } from '../lib/articles';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string; // absolute URL; defaults to the generated /og/default.png
  jsonLd?: Record<string, unknown>[]; // structured data (Article, BreadcrumbList, Organization)
}
const { title, description, noindex = false, ogType = 'website', jsonLd = [], ogImage } = Astro.props;
const image = ogImage ?? new URL('/og/default.png', Astro.site).href;

// Canonical URL: always the durbeen.io address of this page (from `site` in astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Status strip: "LOG UPDATED date · N°nnn" comes from the newest article, on every page.
const latest = (await getArticles())[0];
const log = latest ? { date: logDate(latest.data.publishDate), number: latest.data.number } : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Durbeen" href="/rss.xml" />
    <meta property="og:site_name" content="Durbeen" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline src="/theme-init.js"></script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header log={log} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
  </body>
</html>

---
// Shared layout for plain-text policy pages (Privacy, Terms, Editorial policy, Affiliate disclosure).
// While `preliminary` is true the page shows a clear notice. `npm run check:brackets` flags that notice and any
// [BRACKET] left in the text, so a preliminary page cannot be launched by accident (Phase 8 gate).
import BaseLayout from './BaseLayout.astro';
import Callout from '../components/Callout.astro';

interface Props {
  title: string; // page heading
  description: string;
  label: string; // mono label, e.g. "PRIVACY"
  updated: string; // e.g. "20 Nov 2026"
  preliminary?: boolean;
}
const { title, description, label, updated, preliminary = true } = Astro.props;
---

<BaseLayout title={`${title} | Durbeen`} description={description}>
  <article class="container page">
    <header>
      <p class="label">{label}</p>
      <h1>{title}</h1>
      <p class="label updated">LAST UPDATED {updated.toUpperCase()}</p>
    </header>

    {
      preliminary && (
        <div class="notice">
          <Callout variant="warning" label="PRELIMINARY DRAFT">
            This page is a first draft. It is not legal advice and has not had a legal check yet, so it may change
            before launch.
          </Callout>
        </div>
      )
    }

    <div class="prose"><slot /></div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(48px, 6vw, 96px) var(--space-section);
  }
  .label {
    margin: 0 0 var(--space-3);
  }
  .updated {
    margin: var(--space-3) 0 0;
  }
  h1 {
    margin: 0;
    font-size: var(--fs-article-title);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .notice {
    max-width: var(--reading-width);
    margin-top: var(--space-4);
  }
  .notice :global(.callout) {
    margin: 0;
  }
  .prose {
    max-width: var(--reading-width);
    margin-top: var(--space-5);
    font-size: 18px;
    line-height: 1.7;
    color: var(--text);
  }
  .prose :global(h2) {
    margin: 48px 0 16px;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 20px;
  }
  .prose :global(ul) {
    padding-left: 24px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
</style>

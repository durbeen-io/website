---
// Shared layout for plain-text policy pages (Privacy, Terms, Editorial policy, Affiliate disclosure).
// The founder reviewed and approved the legal text on 23 Nov 2026, so the "PRELIMINARY DRAFT" notice is gone.
// `npm run check:brackets` still flags any [BRACKET] placeholder left in a page.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string; // page heading
  description: string;
  label: string; // mono label, e.g. "PRIVACY"
  updated: string; // e.g. "20 Nov 2026"
}
const { title, description, label, updated } = Astro.props;
---

<BaseLayout title={`${title} | Durbeen`} description={description}>
  <article class="container page">
    <header>
      <p class="label">{label}</p>
      <h1>{title}</h1>
      <p class="label updated">LAST UPDATED {updated.toUpperCase()}</p>
    </header>

    <div class="prose"><slot /></div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(48px, 6vw, 96px) var(--space-section);
  }
  .label {
    margin: 0 0 var(--space-3);
  }
  .updated {
    margin: var(--space-3) 0 0;
  }
  h1 {
    margin: 0;
    font-size: var(--fs-article-title);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .prose {
    max-width: var(--reading-width);
    margin-top: var(--space-5);
    font-size: 18px;
    line-height: 1.7;
    color: var(--text);
  }
  .prose :global(h2) {
    margin: 48px 0 16px;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 20px;
  }
  .prose :global(ul) {
    padding-left: 24px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
</style>

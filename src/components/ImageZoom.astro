---
// Tap-to-zoom viewer for article images: one <dialog class="zoom" aria-label="Enlarged image" data-zoom-dialog>
  <div class="bar"><button type="button" class="close" data-zoom-close>CLOSE</button></div>
  <div class="stage" data-zoom-stage></div>
</dialog>

<style>
  .zoom {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    background: var(--paper);
    overflow: auto;
  }
  .zoom[open] {
    display: flex;
    flex-direction: column;
  }
  .zoom::backdrop {
    background: var(--paper);
  }
  .bar {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    flex: none;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .stage {
    flex: 1 0 auto;
    display: flex;
    padding: var(--space-2);
  }
  .stage :global(img) {
    display: block;
    max-width: 100%;
    margin: auto; /* centred both ways when it is smaller than the space */
    object-fit: contain;
    touch-action: pinch-zoom pan-x pan-y;
  }
  @media (min-width: 768px) {
    .stage :global(img) {
      max-height: calc(100dvh - 120px);
    }
  }
  @media (max-width: 767px) {
    .stage :global(img) {
      width: 170vw; /* wider than the screen: scroll sideways to read small text */
      max-width: none;
      height: auto;
    }
  }
  .close {
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    padding: 0 16px;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    cursor: pointer;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
  const stage = dialog?.querySelector<HTMLElement>('[data-zoom-stage]');
  if (dialog && stage && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('a[data-zoom]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const big = document.createElement('img');
        big.alt = a.dataset.alt ?? '';
        big.src = a.href;
        stage.replaceChildren(big);
        dialog.showModal();
        dialog.scrollTo(0, 0);
      });
    });
    // Tapping the empty space (not the picture, so panning never closes it) closes the viewer.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === stage) dialog.close();
    });
    dialog.querySelector('[data-zoom-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => stage.replaceChildren());
  }
</script>

---
// Section label: "[ 01 ] INSIGHTS". Monospace, uppercase, muted.
// `number` is padded to two digits. Use `as` to pick the element (default <p>).
// Visual only: the real heading below it carries the structure.
interface Props {
  number: number;
  as?: 'p' | 'span' | 'div';
  onDark?: boolean;
}
const { number, as: El = 'p', onDark = false } = Astro.props;
const n = String(number).padStart(2, '0');
---

<El class:list={['section-label', { 'on-dark': onDark }]}>
  <span aria-hidden="true">[ {n} ]</span>
  <span class="visually-hidden">Section {number}:</span>
  <slot />
</El>

<style>
  .section-label {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .on-dark {
    color: var(--accent-on-dark);
  }
</style>

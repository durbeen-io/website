---
// Site footer (CLAUDE.md section 8): newsletter, Explore, Work with Durbeen,
// Elsewhere (GitHub, RSS), the large DURBEEN wordmark, and the policy links.
// LinkedIn is left out until the founder supplies the URL. Nothing is guessed.
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  newsletterAction?: string; // Kit form URL, set in Phase 5
}
const { newsletterAction } = Astro.props;

const explore = [
  { label: 'Insights', href: '/insights/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Toolkit', href: '/toolkit/' },
  { label: 'About', href: '/about/' },
];
const elsewhere = [
  { label: 'GitHub ↗', href: 'https://github.com/durbeen-io', external: true },
  { label: 'RSS', href: '/rss.xml', external: false },
];
const legal = [
  { label: 'Editorial policy', href: '/editorial-policy/' },
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Terms', href: '/terms/' },
  { label: 'Affiliate disclosure', href: '/affiliate-disclosure/' },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="signup">
        <h2 class="signup-title">Get the field notes.</h2>
        <p class="signup-text">
          New reviews and experiments. No spam.
        </p>
        <NewsletterForm id="footer-newsletter" action={newsletterAction} />
      </div>

      <div class="links">
        <nav aria-label="Explore">
          <p class="group">EXPLORE</p>
          <ul>{explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
        <nav aria-label="Work with Durbeen">
          <p class="group">WORK</p>
          <ul><li><a href="/work-with-durbeen/">Work with Durbeen</a></li></ul>
        </nav>
        <nav aria-label="Elsewhere">
          <p class="group">ELSEWHERE</p>
          <ul>
            {elsewhere.map((l) => (
              <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <p class="wordmark" aria-hidden="true">DURBEEN</p>

    <div class="bottom">
      <span>© {year} DURBEEN · DISCOVER. BUILD. INNOVATE.</span>
      <ul>{legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--ink);
    padding-top: var(--space-6);
    padding-bottom: var(--space-2);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6) 48px;
    margin-bottom: var(--space-7);
  }
  .signup {
    flex: 1 1 360px;
    min-width: 0;
  }
  .signup-title {
    margin-bottom: var(--space-2);
    font-size: 28px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .signup-text {
    max-width: 420px;
    margin: 0 0 var(--space-3);
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    font-size: 15px;
  }
  .group {
    margin: 0 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-label-sm);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a,
  .bottom a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    text-decoration: none;
  }
  .links a:hover,
  .bottom a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.3em;
  }
  .wordmark {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 15vw, 224px);
    line-height: 0.8;
    letter-spacing: var(--track-wordmark);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0 var(--space-3);
    padding-top: var(--space-1);
    border-top: var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-label-sm);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }
  .bottom a {
    color: var(--muted);
  }
</style>

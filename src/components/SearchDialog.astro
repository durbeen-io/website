---
// Site search. Opens from the header's search button; reads the Pagefind index that `npm run build` writes to
// dist/pagefind/. Static: no server, no tracking. Only articles are indexed (data-pagefind-body on the article page).
// Pagefind's own script is loaded only when someone opens search, so it costs nothing on first load.
---

<dialog class="search" aria-label="Search" data-search-dialog>
  <div class="panel">
    <form role="search" data-search-form>
      <label for="site-search" class="label">SEARCH ARTICLES</label>
      <div class="field">
        <input id="site-search" type="search" name="q" autocomplete="off" spellcheck="false" placeholder="Search" />
        <!-- A real submit button makes the form valid HTML. Hidden and out of the Tab order; results still update as you type. -->
        <button type="submit" class="visually-hidden" tabindex="-1">Search</button>
        <button type="button" class="close" data-search-close>CLOSE</button>
      </div>
    </form>
    <p class="status label" role="status" data-search-status></p>
    <ul class="results" data-search-results></ul>
  </div>
</dialog>

<style>
  .search {
    width: min(720px, calc(100vw - 32px));
    max-height: calc(100dvh - 64px);
    margin: 32px auto auto;
    padding: 0;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--text);
    overflow: auto;
  }
  .search::backdrop {
    background: color-mix(in srgb, var(--ink) 55%, transparent);
  }
  .panel {
    padding: var(--space-3);
  }
  .label {
    display: block;
    margin-bottom: var(--space-1);
  }
  .field {
    display: flex;
    gap: var(--space-1);
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 17px;
  }
  input::-webkit-search-cancel-button {
    -webkit-appearance: none; /* the browser's blue clear button is off-brand; Esc closes, select-all clears */
  }
  .close {
    min-width: var(--touch-target);
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid var(--ui-border);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .status {
    margin: var(--space-2) 0 0;
    min-height: 1.4em;
  }
  .results {
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }
  .results :global(li) {
    border-top: 1px solid var(--line);
  }
  .results :global(a) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-2) 0;
    min-height: var(--touch-target);
    color: var(--ink);
    text-decoration: none;
  }
  .results :global(.meta) {
    font-family: var(--font-mono);
    font-size: var(--fs-label-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .results :global(.title) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .results :global(a:hover .title) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .results :global(.excerpt) {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .results :global(mark) {
    background: transparent;
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  if (dialog && typeof dialog.showModal === 'function') {
    const input = dialog.querySelector<HTMLInputElement>('input')!;
    const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;
    const list = dialog.querySelector<HTMLElement>('[data-search-results]')!;

    // Pagefind is loaded on first open. In `npm run dev` the index does not exist, so we say so.
    let pagefind: any;
    const load = async () => {
      if (pagefind !== undefined) return pagefind;
      try {
        const url = '/pagefind/pagefind.js';
        pagefind = await import(/* @vite-ignore */ url);
        await pagefind.init();
      } catch {
        pagefind = null;
      }
      return pagefind;
    };

    const run = async () => {
      const q = input.value.trim();
      list.replaceChildren();
      if (!q) {
        status.textContent = '';
        return;
      }
      const pf = await load();
      if (!pf) {
        status.textContent = 'SEARCH IS AVAILABLE IN THE BUILT SITE';
        return;
      }
      const search = await pf.debouncedSearch(q, {}, 150);
      if (search === null) return; // a newer search replaced this one
      const hits = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
      status.textContent = hits.length === 0 ? `NO RESULTS FOR “${q.toUpperCase()}”` : `${search.results.length} ${search.results.length === 1 ? 'RESULT' : 'RESULTS'}`;
      hits.forEach((h: any) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = h.url;
        const meta = document.createElement('span');
        meta.className = 'meta';
        meta.textContent = [h.meta?.number, h.meta?.type].filter(Boolean).join(' · ');
        const title = document.createElement('span');
        title.className = 'title';
        title.textContent = h.meta?.title ?? h.url;
        const excerpt = document.createElement('span');
        excerpt.className = 'excerpt';
        // The excerpt comes from our own index and only contains <mark> tags around the matched words.
        excerpt.innerHTML = h.excerpt;
        a.append(meta, title, excerpt);
        li.append(a);
        list.append(li);
      });
    };

    document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        dialog.showModal();
        input.focus();
        input.select();
        void load(); // warm up while the visitor types
      }),
    );
    input.addEventListener('input', () => void run());
    // In a search field the first Esc would only clear the text; here Esc always closes.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        dialog.close();
      }
    });
    dialog.querySelector('[data-search-form]')?.addEventListener('submit', (e) => e.preventDefault());
    dialog.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
    // Click on the dark backdrop closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

---
// ArticleCard. Two looks:
//   default  = text card for grids ("011 · EXPERIMENT", title, summary, "6 MIN READ")
//   featured = big card with a figure on the left (Home "Insights" section, Insights top)
// The whole card is clickable through ONE link on the title (the "stretched link" trick),
// so there are no nested links and a screen reader hears just the title as the link name.
// The figure is a slot: pass an image (Phase 4 image handling) or leave it empty for the
// reticle placeholder. It only draws what it is given; data comes from the content collection.
interface Props {
  number: number;
  type: string; // article type, e.g. "Experiment"
  title: string;
  description: string;
  href: string;
  minutes: number;
  date?: Date; // shown on the featured card only
  author?: string;
  variant?: 'default' | 'featured';
  headingLevel?: 2 | 3 | 4;
}
const {
  number,
  type,
  title,
  description,
  href,
  minutes,
  date,
  author = 'Fahad Ehsan',
  variant = 'default',
  headingLevel = 3,
} = Astro.props;
const n = String(number).padStart(3, '0');
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const featured = variant === 'featured';
const dateText = date
  ? date
      .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
      .toUpperCase()
  : undefined;
---

<article class:list={['card', { featured }]}>
  {
    featured && (
      <div class="figure">
        <slot name="figure">
          <svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <pattern id={`grid-${n}`} width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M40 0H0V40" fill="none" stroke="var(--line)" stroke-width="1" />
              </pattern>
            </defs>
            <rect width="640" height="400" fill={`url(#grid-${n})`} />
            <circle cx="400" cy="200" r="130" fill="none" stroke="var(--ink)" stroke-width="1.2" />
            <circle cx="400" cy="200" r="64" fill="var(--accent)" />
            <path d="M400 40v60M400 300v60M240 200h60M500 200h60" stroke="var(--ink)" stroke-width="1.2" />
          </svg>
        </slot>
      </div>
    )
  }
  <div class="body">
    <div class="text">
      <p class="meta">
        {featured ? <span class="flag">FEATURED · {type}</span> : <span>{n} · {type}</span>}
      </p>
      <Heading class="title"><a href={href}>{title}</a></Heading>
      <p class="desc">{description}</p>
    </div>
    <p class="foot">
      {featured && <span>{author}</span>}
      {dateText && <span>{dateText}</span>}
      <span>{minutes} MIN READ</span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative; /* anchors the stretched link */
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
  }
  .body,
  .text {
    display: flex;
    flex-direction: column;
  }
  .body {
    gap: 16px;
    flex: 1;
  }
  .meta,
  .foot {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0; /* the whole card becomes the click and tap target */
  }
  .card:hover .title a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .title a:focus-visible {
    outline: none; /* the ring goes on the whole card instead */
  }
  .card:has(.title a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .desc {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin-top: auto;
  }

  /* featured */
  .featured {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 40px 48px;
    padding-top: 40px;
  }
  .figure {
    flex: 6 1 480px;
    min-width: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
  }
  .figure :global(svg),
  .figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured .body {
    flex: 5 1 360px;
    min-width: 0;
    justify-content: space-between;
    gap: 32px;
  }
  .flag {
    color: var(--accent); /* mono label, not body text; 4.7:1 on paper */
  }
  .featured .title {
    margin-top: 20px;
    font-size: clamp(32px, 3.4vw, 48px);
    line-height: 1.05;
    letter-spacing: var(--track-display);
  }
  .featured .desc {
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.6;
  }
  .featured .foot {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 639px) {
    .figure {
      flex-basis: 100%;
    }
    .featured .body {
      flex-basis: 100%;
    }
  }
</style>

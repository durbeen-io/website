---
// Header block for list pages (Insights, category, tag, series): mono label, big title, one short intro line.
interface Props {
  label: string;
  title: string;
  intro?: string;
  back?: boolean; // show a "← All insights" link (category, tag and series pages)
}
const { label, title, intro, back = false } = Astro.props;
---

<header class="list-head container">
  <p class="label">{label}</p>
  {back && <a class="back" href="/insights/">← All insights</a>}
  <h1>{title}</h1>
  {intro && <p class="intro">{intro}</p>}
</header>

<style>
  .list-head {
    padding-block: clamp(48px, 6vw, 96px) clamp(32px, 4vw, 56px);
  }
  .label {
    margin: 0 0 var(--space-4);
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    margin: calc(-1 * var(--space-2)) 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-article-title);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .intro {
    max-width: 640px;
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-2);
  }
</style>

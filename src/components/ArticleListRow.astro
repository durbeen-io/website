---
// One row of an article list (Insights, category, tag and series pages): mono metadata on the left,
// large title and description on the right. The data-* attributes let the Insights filters hide rows.
interface Props {
  number: number;
  type: string;
  level: string;
  category: string;
  title: string;
  description: string;
  minutes: number;
  href: string;
  first?: boolean;
}
const { number, type, level, category, title, description, minutes, href, first = false } = Astro.props;
const n = String(number).padStart(3, '0');
---

<li class:list={['row', { first }]} data-article data-category={category} data-type={type} data-level={level}>
  <a href={href}>
    <span class="meta">
      <span>{n} · {type.toUpperCase()}</span>
      <span>{level.toUpperCase()} · {minutes} MIN</span>
    </span>
    <span class="main">
      <span class="title">{title}</span>
      <span class="desc">{description}</span>
    </span>
  </a>
</li>

<style>
  .row {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .row.first {
    border-top-color: var(--ink);
  }
  .row[hidden] {
    display: none;
  }
  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding: var(--space-5) 0;
    min-height: var(--touch-target);
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 760px) {
    a {
      grid-template-columns: 220px minmax(0, 1fr);
    }
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(24px, 2.4vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  a:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .desc {
    max-width: 640px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-2);
  }
</style>

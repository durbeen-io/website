---
// One tile of the Infographics gallery: one picture from a published article (the hero or a figure in the text),
// its caption, and a link back to the article, which holds the full written version.
// The picture is never cropped. The whole tile is one link (the "From:" line), like ArticleCard.
// data-* lets the category filter hide it.
import { Picture } from 'astro:assets';

interface Props {
  number: number; // log number of the article the picture comes from
  category: string;
  fromTitle: string; // title of that article
  caption?: string; // the figure's caption, when it has one
  href: string; // the article
  image: ImageMetadata;
  alt: string;
}
const { number, category, fromTitle, caption, href, image, alt } = Astro.props;
const n = String(number).padStart(3, '0');
---

<li class="card" data-article data-category={category}>
  <div class="frame">
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[320, 480, 640]}
      sizes="(min-width: 1100px) 300px, (min-width: 640px) 33vw, calc(100vw - 48px)"
      loading="lazy"
      decoding="async"
    />
  </div>
  <p class="meta">N°{n} · {category.toUpperCase()}</p>
  {caption && <p class="caption">{caption}</p>}
  <p class="from">From: <a href={href}>{fromTitle}</a></p>
</li>

<style>
  .card {
    position: relative; /* anchors the stretched link */
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
  }
  .card[hidden] {
    display: none;
  }
  .frame {
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-1);
    border: 1px solid var(--line);
    background: var(--surface-2);
    overflow: hidden;
  }
  .frame :global(picture),
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain; /* the whole infographic stays visible */
  }
  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .caption {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .from {
    margin: 0;
    font-size: 15px;
    line-height: 1.4;
    color: var(--text-2);
  }
  .from a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;
  }
  .from a::after {
    content: '';
    position: absolute;
    inset: 0; /* the whole tile is the tap target */
  }
  .card:hover .from a {
    text-decoration-color: var(--accent);
  }
  .from a:focus-visible {
    outline: none; /* the ring goes on the whole tile */
  }
  .card:has(.from a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
</style>

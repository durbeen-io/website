---
// Light/dark toggle. Follows the system by default; remembers a manual choice.
// A half-filled circle shows "contrast". The label always says what the click will do.
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode">
  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="12" cy="12" r="8"></circle>
    <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    width: var(--touch-target);
    height: var(--touch-target);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--ui-border);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--surface-2);
  }
</style>

<script>
  const root = document.documentElement;
  const dark = window.matchMedia('(prefers-color-scheme: dark)');

  const current = (): 'light' | 'dark' => {
    const set = root.getAttribute('data-theme');
    if (set === 'light' || set === 'dark') return set;
    return dark.matches ? 'dark' : 'light';
  };

  const sync = () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-label', `Switch to ${next} mode`);
    });
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((b) => {
    b.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      sync();
    });
  });

  dark.addEventListener('change', sync); // system changed and no manual choice
  sync();
</script>

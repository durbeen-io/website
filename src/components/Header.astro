---
// Site header: status strip, logo, main nav, optional search, theme toggle.
// Nav (CLAUDE.md section 8): Insights · Projects · Toolkit · About · (search).
// Below 860px the nav collapses behind a MENU button (only when scripts run; without JS it stays open).
// `search` shows the search button (the dialog is SearchDialog, mounted once in BaseLayout; index from Pagefind).
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import StatusStrip from './StatusStrip.astro';

interface Props {
  search?: boolean;
  log?: { date: string; number: number };
  currentPath?: string;
  navLabel?: string; // only change when two headers share a page (the preview page): landmarks need unique names
  id?: string; // nav id; only change if two headers share a page (the preview page)
}
const { search = true, log, currentPath = Astro.url.pathname, id = 'site-nav', navLabel = 'Main' } = Astro.props;

const nav = [
  { label: 'Insights', href: '/insights/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Toolkit', href: '/toolkit/' },
  { label: 'About', href: '/about/' },
];
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<StatusStrip log={log} />
<header class="site-header" data-site-header>
  <div class="container bar">
    <a class="home" href="/" aria-label="Durbeen home"><Logo size={32} wordmark /></a>

    <div class="tools">
      {
        search && (
          <button type="button" class="icon-btn" aria-label="Search" data-search-open>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="11" cy="11" r="7" />
              <path d="M20 20l-3.5-3.5" />
            </svg>
          </button>
        )
      }
      <ThemeToggle />
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls={id} data-menu-btn>
        <span data-menu-label>MENU</span>
      </button>
    </div>

    <nav id={id} class="nav" aria-label={navLabel} data-nav>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-1);
    padding-block: var(--space-2);
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    text-decoration: none;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    order: 2;
  }
  .nav {
    order: 3;
    width: 100%;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-top: var(--border);
    font-size: 17px;
    font-weight: 500;
    text-decoration: none;
  }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
  .nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.4em;
  }

  .icon-btn,
  .menu-btn {
    min-width: var(--touch-target);
    height: var(--touch-target);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--ui-border);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .icon-btn:hover,
  .menu-btn:hover {
    background: var(--surface-2);
  }
  .menu-btn {
    display: none; /* shown only when scripts run, on small screens */
    padding-inline: 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
  }

  /* Small screens, scripts running: collapsed nav behind the MENU button */
  :global(html.js) .menu-btn {
    display: inline-flex;
  }
  :global(html.js) .nav {
    display: none;
  }
  :global(html.js) .site-header.open .nav {
    display: block;
  }

  /* Wide screens: one row */
  @media (min-width: 860px) {
    .bar {
      flex-wrap: nowrap;
    }
    .tools {
      order: 3;
    }
    .nav {
      order: 2;
      width: auto;
      margin-left: auto;
      margin-right: var(--space-3);
    }
    .nav ul {
      display: flex;
      gap: var(--space-4);
    }
    .nav a {
      min-height: var(--touch-target);
      border-top: 0;
      font-size: 15px;
    }
    :global(html.js) .menu-btn {
      display: none;
    }
    :global(html.js) .nav {
      display: block;
    }
  }
</style>

<script>
  // MENU button: open/close the nav on small screens. Esc closes it and returns focus to the button.
  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const label = header.querySelector<HTMLElement>('[data-menu-label]');
    if (!btn || !label) return;

    const set = (open: boolean) => {
      header.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'CLOSE' : 'MENU';
    };

    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    header.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    // If the window grows to the desktop layout, reset the menu state
    window.matchMedia('(min-width: 860px)').addEventListener('change', (m) => {
      if (m.matches) set(false);
    });
  });
</script>

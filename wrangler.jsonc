{
  // Cloudflare Workers settings. The site is fully static: no Worker script,
  // just the built files in dist/. "name" must match the Worker name in the
  // Cloudflare dashboard, or the build fails.
  "name": "durbeen-website",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html (the on-brand 404 page) with a 404 status for unknown addresses.
    "not_found_handling": "404-page"
  },
  // Serve on the free *.workers.dev address, and give every branch a preview URL.
  // Set explicitly so a Wrangler default can never change them silently.
  "workers_dev": true,
  "preview_urls": true,
  // Do not send Wrangler usage data to Cloudflare.
  "send_metrics": false,
  // Required by Worker Previews (`wrangler preview`, used for branch builds).
  // Empty on purpose: the preview needs no settings different from production.
  "previews": {}
}
